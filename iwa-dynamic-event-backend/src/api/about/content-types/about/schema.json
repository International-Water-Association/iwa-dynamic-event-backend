{
  "kind": "collectionType",
  "collectionName": "abouts",
  "info": {
    "singularName": "about",
    "pluralName": "abouts",
    "displayName": "About"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "subTitle": {
      "type": "string"
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "imageTextBlock": {
      "type": "dynamiczone",
      "components": [
        "component.image-text"
      ]
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "btn_text": {
      "type": "string"
    },
    "btn_link": {
      "type": "text"
    }
  }
}

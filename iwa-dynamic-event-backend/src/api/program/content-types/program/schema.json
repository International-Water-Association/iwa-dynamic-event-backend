{
  "kind": "collectionType",
  "collectionName": "programs",
  "info": {
    "singularName": "program",
    "pluralName": "programs",
    "displayName": "Program"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "day": {
      "type": "enumeration",
      "enum": [
        "Day 1",
        "Day2"
      ]
    },
    "title": {
      "type": "text"
    },
    "subTitle": {
      "type": "string"
    },
    "details": {
      "type": "dynamiczone",
      "components": [
        "component.program-details"
      ]
    },
    "date": {
      "type": "date"
    },
    "mainSubTitle": {
      "type": "string"
    },
    "mainTitle": {
      "type": "string"
    },
    "Description": {
      "type": "text"
    },
    "Points": {
      "type": "richtext"
    },
    "committee": {
      "type": "component",
      "component": "component.advisory-commitee",
      "repeatable": false
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    }
  }
}
